<!--
  Kiosk design tokens — same values as apps/web/src/styles/tokens.css (design/gymli-design.html, screens 05a–c).
  Use these resources only; no colours or sizes inline in the views.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="InkColor">#111312</Color>
  <Color x:Key="GreenColor">#2FD16E</Color>
  <Color x:Key="RedColor">#FF5D4F</Color>

  <SolidColorBrush x:Key="Ink" Color="#111312" />
  <SolidColorBrush x:Key="Ink2" Color="#3F4743" />
  <SolidColorBrush x:Key="Muted" Color="#5C6560" />
  <SolidColorBrush x:Key="White" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Green" Color="#2FD16E" />
  <SolidColorBrush x:Key="GreenMark" Color="#1DB85A" />
  <SolidColorBrush x:Key="Yellow" Color="#FFD43D" />
  <SolidColorBrush x:Key="Red" Color="#FF5D4F" />
  <SolidColorBrush x:Key="Chip" Color="#EEF1EF" />
  <SolidColorBrush x:Key="Step" Color="#E3E7E4" />
  <SolidColorBrush x:Key="GlassKiosk" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="GlassOrb" Color="#CCFFFFFF" />
  <SolidColorBrush x:Key="GlassEdge" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="GlassOnGreen" Color="#66FFFFFF" />
  <SolidColorBrush x:Key="Line6" Color="#0F111312" />
  <SolidColorBrush x:Key="Line8" Color="#14111312" />
  <SolidColorBrush x:Key="Rail" Color="#161817" />
  <SolidColorBrush x:Key="Faint" Color="#9BA39F" />
  <SolidColorBrush x:Key="RailChip" Color="#22FFFFFF" />

  <!-- Idle background: soft green glow on the app gradient -->
  <LinearGradientBrush x:Key="AppGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#F2F4F5" />
    <GradientStop Offset="0.48" Color="#ECEFEF" />
    <GradientStop Offset="1" Color="#E3EFE7" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="IdleGlow" Center="50%,45%" GradientOrigin="50%,45%" RadiusX="62%" RadiusY="66%">
    <GradientStop Offset="0" Color="#DDF4E5" />
    <GradientStop Offset="0.7" Color="#00DDF4E5" />
  </RadialGradientBrush>

  <BoxShadows x:Key="OrbShadow">0 30 60 -30 #59103C23</BoxShadows>

  <!-- Archivo instances (variable font pinned to the design's widths/weights) -->
  <FontFamily x:Key="FontBlack">avares://Gymli.Checkin/Assets/Fonts#GymliDisplay62</FontFamily>       <!-- 62% / 900: WELCOME, DENIED -->
  <FontFamily x:Key="FontTitle">avares://Gymli.Checkin/Assets/Fonts#GymliDisplay64</FontFamily>       <!-- 64% / 800 -->
  <FontFamily x:Key="FontHeavy">avares://Gymli.Checkin/Assets/Fonts#GymliDisplay66</FontFamily>       <!-- 66% / 800 -->
  <FontFamily x:Key="FontBold">avares://Gymli.Checkin/Assets/Fonts#GymliDisplay68</FontFamily>         <!-- 68% / 800 -->
  <FontFamily x:Key="FontText">avares://Gymli.Checkin/Assets/Fonts#GymliText500</FontFamily>         <!-- 100% / 500 -->
  <FontFamily x:Key="FontSemibold">avares://Gymli.Checkin/Assets/Fonts#GymliText600</FontFamily> <!-- 100% / 600 -->
  <FontFamily x:Key="FontStrong">avares://Gymli.Checkin/Assets/Fonts#GymliText700</FontFamily>     <!-- 100% / 700 -->

  <!-- Lucide icons (24×24 stroke paths, as in the design) -->
  <StreamGeometry x:Key="IconFingerprint">M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4 M14 13.12c0 2.38 0 6.38-1 8.88 M17.29 21.02c.12-.6.43-2.3.5-3.02 M2 12a10 10 0 0 1 18-6 M2 16h.01 M21.8 16c.2-2 .131-5.354 0-6 M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2 M8.65 22c.21-.66.45-1.32.57-2 M9 6.8a6 6 0 0 1 9 5.2v2</StreamGeometry>
  <StreamGeometry x:Key="IconLock">M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z M7 11V7a5 5 0 0 1 10 0v4</StreamGeometry>
  <StreamGeometry x:Key="IconLockOpen">M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z M7 11V7a5 5 0 0 1 9.9-1</StreamGeometry>
  <StreamGeometry x:Key="IconWifiOff">M12 20h.01 M8.5 16.429a5 5 0 0 1 7 0 M5 12.859a10 10 0 0 1 5.17-2.69 M19 12.859a10 10 0 0 0-2.007-1.523 M2 8.82a15 15 0 0 1 4.177-2.643 M22 8.82a15 15 0 0 0-11.288-3.764 M2 2l20 20</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M20 6L9 17l-5-5</StreamGeometry>
</ResourceDictionary>
