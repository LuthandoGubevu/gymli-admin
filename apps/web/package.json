{
  "name": "gymli-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-gymli \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-gymli",
    "seed": "tsx scripts/seed.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "demo": "tsx scripts/demo.ts",
    "e2e": "playwright test",
    "visual": "tsx tests/visual/compare.ts",
    "visual:responsive": "tsx tests/visual/responsive.ts",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
